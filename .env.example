# ── labMail environment ─────────────────────────────────────────────────────
# Google credentials do NOT belong here. They are runtime settings entered
# through the admin UI after the service is running, so a deployment can be
# brought up by someone who has not yet created a Google Cloud project.

# The bootstrap operator account. This is the only way into a fresh deployment.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator

# Required, minimum 12 characters. Use a generated value:
#   openssl rand -base64 24
ADMIN_PASSWORD=

# The port the service listens on, published unchanged on the host. It binds
# 0.0.0.0, so it is reachable at http://<host-ip>:<PORT>.
PORT=8000

# Only needed behind a reverse proxy that rewrites the Host header. When unset,
# the OAuth redirect URI follows whatever address the browser used, which is
# what makes access by raw host IP work with no configuration.
# PUBLIC_URL=https://mail.example.com

# Where the SQLite database lives. Inside the container this is set to
# /app/data/labmail.db and backed by a volume; override only for local runs.
# DATABASE_PATH=./data/labmail.db

# How long the audit log keeps access records, in days. It records who opened
# which message, who sent what, and every administrative decision — the only
# way to answer those questions later, since separation between members is
# enforced by this application rather than by Google. 0 keeps everything.
# AUDIT_RETENTION_DAYS=365

# SMTP submission for desktop and phone mail clients. 0 leaves it off.
# Mail clients authenticate with a member's own address and password, and
# messages go out through the same path the web composer uses.
#
# Plaintext by design: put a TLS terminator in front of it, publishing 465 and
# proxying to this port. See docs/mail-clients.md for the nginx configuration.
SMTP_PORT=0

# Interface the submission port binds to. 0.0.0.0 inside a container, where
# the compose mapping is what restricts it to the host's loopback.
SMTP_HOST=0.0.0.0

# IMAP. Clients can list, read, search, flag, move and delete; flags and moves
# are recorded per member, exactly as the web interface records them. Same
# shape as submission -- publish 993 with TLS and proxy to this port.
IMAP_PORT=0
IMAP_HOST=0.0.0.0
IMAP_PROXY_PROTOCOL=false

# Interface the plaintext mail ports are published on. Loopback when the TLS
# terminator runs on this host; its LAN address when nginx sits elsewhere.
# Never an address reachable from the internet -- there is no TLS here.
MAIL_BIND=127.0.0.1

# Log the IMAP and SMTP exchange, credentials redacted. For diagnosing a client
# that reports a sign-in failure when the sign-in in fact succeeded.
MAIL_TRACE=false
